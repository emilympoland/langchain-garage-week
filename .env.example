# --- LangSmith (required for Modules 2 and 3, recommended everywhere) ---
LANGSMITH_TRACING="true"
# Defaults to the GCP US SaaS region. If your LangSmith org/workspace lives in a
# different region, change this to match -- your API key only authenticates
# against its own region's endpoint:
#   GCP US:   https://api.smith.langchain.com       (default)
#   GCP EU:   https://eu.api.smith.langchain.com
#   GCP APAC: https://apac.api.smith.langchain.com
#   AWS US:   https://aws.api.smith.langchain.com
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_PROJECT="modular-workshops"

# Only needed if you flip on the commented-out LangSmith Gateway block in
# utils/models.py. Same value as LANGSMITH_API_KEY, under a non-reserved name.
# LANGSMITH_API_KEY_GATEWAY="<langsmith-api-key>"

# --- Model providers (set whichever your workshop uses) ---
OPENAI_API_KEY="<openai-api-key>"
# ANTHROPIC_API_KEY="<anthropic-api-key>"

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# --- Tools used by Module 1 (Deep Agents) and Module 3 (LangSmith) ---
TAVILY_API_KEY="<tavily-api-key>"
