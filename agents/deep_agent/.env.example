# `mda` reads .env from this project's own directory (not the workshop root
# .env) -- copy this file to `.env` here and fill in your keys.
#
# Reserved keys (LANGSMITH_API_KEY, LANGSMITH_WORKSPACE_ID, ...) are stripped
# before upload; everything else is forwarded to the deployment as a secret.

# Defaults to the GCP US SaaS region. If your LangSmith org/workspace lives in
# a different region, change this to match -- your API key only authenticates
# against its own region's endpoint. See the table in the workshop root's
# .env.example for the other three endpoints.
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"

OPENAI_API_KEY="<openai-api-key>"
TAVILY_API_KEY="<tavily-api-key>"

# Only needed if the Gateway block in agent.py is active (Module 2 §1.4).
# Same key as LANGSMITH_API_KEY, under a non-reserved name.
# LANGSMITH_API_KEY_GATEWAY="<langsmith-api-key>"
